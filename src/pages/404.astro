---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 — 页面不存在 | AmritaBot"
  description="你访问的页面在 amritabot.com 上不存在。"
  noindex
>
  <Nav />

  <main id="main" class="flex min-h-[60vh] items-center justify-center px-6 py-24">
    <div class="text-center">
      <p class="bg-gradient-tech bg-clip-text text-6xl font-bold text-transparent">404</p>
      <h1 class="mt-4 text-2xl font-bold text-white">这个页面不存在</h1>
      <p class="mt-2 text-gray-400">链接可能已经失效，或者页面已经迁移。</p>

      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary-strong px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
      >
        返回首页
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

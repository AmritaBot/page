---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 — Page not found | AmritaBot"
  description="The page you were looking for does not exist on amritabot.com."
  noindex
>
  <Nav />

  <main class="flex min-h-[60vh] items-center justify-center px-6 py-24">
    <div class="text-center">
      <p class="bg-gradient-tech bg-clip-text text-6xl font-bold text-transparent">404</p>
      <h1 class="mt-4 text-2xl font-bold text-white">This page does not exist</h1>
      <p class="mt-2 text-gray-400">The link may be outdated, or the page moved.</p>

      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
      >
        Back to home
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
